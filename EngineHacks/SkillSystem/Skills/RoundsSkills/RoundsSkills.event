PUSH

//Armsthrift
ORG $2B7F8
jumpToHack(Armsthrift)
  
//Dazzle (can't be countered)
ORG 0x2C864
jumpToHack(DazzleCheck)

//Desperation
ORG $2AF0A
SHORT 0
jumpToHack(Desperation)

POP

ALIGN 4
Armsthrift:
AxeFaithArmsthrift:
ArmsthriftAxeFaith:
//Try to figure a way to have luck% Armsthrift (eg: Hortensia)
//and 100% Armsthrift (Star Orb) at the same time
//#incbin "Armsthrift/armsthriftaxefaith.dmp"
#incbin "StarOrbEffect/starorb.dmp"
POIN SkillTester|1
WORD ArmsthriftID AxeFaithID StarOrbID

ALIGN 4
DazzleCheck:
#incbin "Dazzle/dazzle.dmp"
POIN SkillTester
WORD DazzleID
WORD MoonlightID

ALIGN 4
Desperation:
#incbin "Desperation/DesperationAssassinate.dmp"
POIN SkillTester
WORD DesperationID
WORD AssassinateID

