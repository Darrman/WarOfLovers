//Class card variant
#define setClassCard(cardEntry, cardLocation) "PUSH; ORG PortraitTable+cardEntry*0x1C; WORD 0x0; WORD 0x0; POIN cardLocation; WORD 0x0; POIN cardLocation+0x20; WORD 0x0; WORD 0x01; POP"

Cavalier_Card:
ALIGN 4
#incbin "bin/Cavalier.pal.bin"
#incbin "bin/Cavalier.img.bin"
setClassCard(P_Cavalier,Cavalier_Card)

