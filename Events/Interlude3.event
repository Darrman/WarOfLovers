EventPointerTable(0xAC, PointerList)

ALIGN 4
PointerList:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN Dunno1 Dunno2 Dunno3 Tutorial
POIN Traps1 Traps2
POIN Good Good  //This unit group determines the number and position of deployment slots when there is a prep screen
POIN $0 $0 $0
POIN $0 $0 $0
POIN BeginningScene EndingScene

TurnBasedEvents:
END_MAIN

CharacterBasedEvents:
END_MAIN

LocationBasedEvents:
END_MAIN

MiscBasedEvents:
CauseGameOverIfLordDies
END_MAIN

Dunno1:
END_MAIN

Dunno2:
END_MAIN

Dunno3:
END_MAIN

Tutorial:
END_MAIN

Good:
UNIT Marth EirikaMasterLord 0x00 Level(1,Ally,0) [13,8] 0x0  0x0 0x0 0x0 [SilverSword, Vulnerary] NoAI
UNIT

RodyGroup:
UNIT Rody DukeKnight 0x00 Level(1,Ally,0) [0,0] 0x0 0x0 0x0 0x0 [SilverLance, Javelin] NoAI
UNIT

RosheGroup:
UNIT Roshe GreatKnight 0x00 Level(1,Ally,0) [0,0] 0x0 0x0 0x0 0x0 [SilverAxe, Hammer] NoAI
UNIT

LindaGroup:
UNIT Linda Sage_F 0x00 Level(1,Ally,0) [0,0] 0x0 0x0 0x0 0x0 [Aura, Resire, Heal] NoAI
UNIT

KashimGroup:
UNIT Kashim Horseman 0x00 Level(1,Ally,0) [0,0] 0x0 0x0 0x0 0x0 [KillerBow, SteelSword, BlueGem] NoAI
UNIT

MalliesiaGroup:
UNIT Malliesia Bishop_F 0x00 Level(1,Ally,0) [0,0] 0x0 0x0 0x0 0x0 [Lightning, Hammerne, Physic] NoAI
UNIT

Bad:
UNIT

Traps1:
ENDTRAP
ALIGN 4

Traps2:
ENDTRAP
ALIGN 4

BeginningScene:
EVBIT_MODIFY 1 //No skipping
SetBackground(CGBlackScreen)
TUTORIALTEXTBOXSTART
CenterTutorialTextBox
TEXTSHOW InterludeNotification
TEXTEND
STAL 10
SVAL s1 1
BNE 6201 sC s1 //branch if no

EVBIT_MODIFY 0 //skip away, though if you're going to you should hit yes
FADI 60
STAL 1
CALL $9EE2C4 //EndConvo, get rid of black screen
STAL 10
Text(PlaceholderText)
CALL ReturnOfTheDecoy
CALL EndingScene
ENDA

//End chapter early
LABEL 6201
TUTORIALTEXTBOXSTART
CenterTutorialTextBox
TEXTSHOW InterludeSkipped
TEXTEND
CALL EndingScene
ENDA

EndingScene:
WM_LOADLOCATION2 0 15 0 //Required to fix chapter name
WM_SETDESTINATION 0 15 0 //World map node. Keep these equal.
WM_SETNEXTLOCATION 0 0 15 //Needed for world map narration.
MNCH 17
ENDB

ReturnOfTheDecoy:
CHECK_EVENTID RodyMessenger
BNE 6202 s0 sC
CHECK_EVENTID RosheMessenger
BNE 6203 s0 sC
CHECK_EVENTID LindaMessenger
BNE 6204 s0 sC
CHECK_EVENTID KashimMessenger
BNE 6205 s0 sC
CHECK_EVENTID MalliesiaMessenger
BNE 6206 s0 sC

LABEL 6202
LOAD1 0x1 RodyGroup
ChangeStat(Rody,S_HP,37)
ChangeStat(Rody,S_Str,15)
ChangeStat(Rody,S_Skl,18)
ChangeStat(Rody,S_Spd,19)
ChangeStat(Rody,S_Luk,13)
ChangeStat(Rody,S_Def,12)
ChangeStat(Rody,S_Res,6)
//20/1 averages
//99% sure it's RAM offsets here, changing 0x1 made Rody a Firenese generic
//Well, per builder, he's actually "Max HP increased"?
ENDA
LABEL 6203
LOAD1 0x1 RosheGroup
ChangeStat(Roshe,S_HP,40) //Great knights aren't in FE3, make bonuses up (+4 HP)
ChangeStat(Roshe,S_Str,16) //+3 str
ChangeStat(Roshe,S_Skl,16) //+2 skl
ChangeStat(Roshe,S_Spd,15) //+1 spd
ChangeStat(Roshe,S_Luk,13)
ChangeStat(Roshe,S_Def,16) //+4 def
ChangeStat(Roshe,S_Res,2) //+2 res
ENDA
LABEL 6204
LOAD1 0x1 LindaGroup
ChangeStat(Linda,S_HP,29) //using the Marich bonuses as sage bonuses
ChangeStat(Linda,S_Mag,8)
ChangeStat(Linda,S_Skl,20)
ChangeStat(Linda,S_Spd,20)
ChangeStat(Linda,S_Luk,21)
ChangeStat(Linda,S_Def,5)
ChangeStat(Linda,S_Res,8)
ENDA
LABEL 6205
LOAD1 0x1 KashimGroup
ChangeStat(Kashim,S_HP,36) //horseman promo gains are so miserable! +1 to all.
ChangeStat(Kashim,S_Str,19)
ChangeStat(Kashim,S_Skl,15)
ChangeStat(Kashim,S_Spd,14)
ChangeStat(Kashim,S_Luk,7)
ChangeStat(Kashim,S_Def,12)
ChangeStat(Kashim,S_Res,3)
ENDA
LABEL 6206
LOAD1 0x1 MalliesiaGroup
ChangeStat(Malliesia,S_HP,26)
ChangeStat(Malliesia,S_Mag,9)
ChangeStat(Malliesia,S_Skl,6)
ChangeStat(Malliesia,S_Spd,16)
ChangeStat(Malliesia,S_Luk,18)
ChangeStat(Malliesia,S_Def,4)
ChangeStat(Malliesia,S_Res,8)
ENDA
